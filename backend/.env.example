# HMS Backend — Environment Variables
# =====================================================================
# Copy this file to .env and fill in ALL values before deployment.
# Generate secrets with: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER commit .env to source control.
# =====================================================================

# ---- Application ----
ENV=production
DEBUG_MODE=False

# ---- Security ----
# REQUIRED: Minimum 32 characters. Must not be the dev default.
HMS_SECRET_KEY=your-strong-random-secret-key-here

# Token expiry in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- CORS ----
# Comma-separated list of allowed frontend origins.
# Example: https://hms.yourcompany.com,https://www.yourcompany.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Database ----
# Full SQLAlchemy connection URL.
# SQLite (dev):    sqlite:///./hms.db
# PostgreSQL:      postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://hms_user:CHANGE_ME@localhost:5432/hms_db

# PostgreSQL Docker credentials (used by docker-compose hms-db service)
POSTGRES_USER=hms_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=hms_db

# ---- Email (FastMail / SMTP) ----
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=noreply@yourhospital.com
MAIL_PORT=587
MAIL_SERVER=smtp.yourprovider.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# ---- Frontend ----
# Full public URL of the React app — used in password reset emails.
FRONTEND_URL=https://hms.yourcompany.com

# ---- Webhooks ----
# n8n or any external webhooks for notifications.
APPOINTMENT_WEBHOOK_URL=https://your-n8n-instance/webhook/your-path
LAB_STATUS_WEBHOOK_URL=https://your-n8n-instance/webhook/your-path
INVOICE_WEBHOOK_URL=https://your-n8n-instance/webhook/your-path

# ---- Gunicorn (Docker) ----
# Formula: (2 × CPU cores) + 1
WEB_CONCURRENCY=4
