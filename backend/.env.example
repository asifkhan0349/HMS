# HMS Backend — Environment Variables
# Copy this file to .env and edit as needed for your deployment.

# Secret key used to sign JWT tokens.
# Generate a strong random value for production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
HMS_SECRET_KEY=your-strong-random-secret-key-here

# Token expiry in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed CORS origins.
# For production, set this to your frontend URL, e.g.:
#   ALLOWED_ORIGINS=https://hms.yourcompany.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
